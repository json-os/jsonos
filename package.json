{
  "name": "jsonos",
  "version": "0.0.1",
  "description": "JSON Operating System - A lightweight framework for building decentralized applications with JSON-LD",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "json-ld",
    "linked-data",
    "solid",
    "decentralized",
    "rdf",
    "semantic-web"
  ],
  "author": "json-os contributors",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/json-os/jsonos.git"
  },
  "bugs": {
    "url": "https://github.com/json-os/jsonos/issues"
  },
  "homepage": "https://json-os.github.io",
  "devDependencies": {
    "rollup": "^4.9.0",
    "typescript": "^5.3.0",
    "vitest": "^1.1.0"
  }
}
